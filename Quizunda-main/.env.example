# ==============================================================
# CONFIGURAÇÃO DE AMBIENTE - PLATAFORMA PREPUNI
# ==============================================================

# Ambiente e Porta
NODE_ENV=production
PORT=5000

# Segredo JWT (Gere uma chave longa e aleatória para produção)
JWT_SECRET=substitua_por_uma_chave_secreta_muito_forte_com_pelo_menos_64_caracteres

# Origem autorizada para CORS (URL do seu frontend)
FRONTEND_URL=https://seusite.com
CORS_ORIGIN=https://seusite.com

# URL da API para o frontend React (usado no build)
REACT_APP_API_URL=https://api.seusite.com/api

# Banco de Dados PostgreSQL
# Opção 1: URL de Conexão direta (Recomendado para Neon, Supabase, Render, Railway, Clever Cloud)
DATABASE_URL=postgresql://usuario:senha@host:5432/prepUni_db?sslmode=require
DB_SSL=true

# Opção 2: Credenciais individuais (Caso utilize VPS própria)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=sua_senha_segura
# DB_NAME=prepUni_db
# DB_SSL=false
