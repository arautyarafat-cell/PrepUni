# Configurações de Build para Produção (Vercel)
# Desativa parada do build em caso de ESLint warnings e reduz uso de memória
CI=false
GENERATE_SOURCEMAP=false

# No painel da Vercel (Project Settings -> Environment Variables),
# defina REACT_APP_API_URL com a URL do seu backend no Render:
# REACT_APP_API_URL=https://prepuni-backend.onrender.com/api

